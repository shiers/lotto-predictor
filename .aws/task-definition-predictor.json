{
  "family": "predict-lotto-predictor",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "predict-lotto-predictor",
      "image": "897458219603.dkr.ecr.ap-southeast-2.amazonaws.com/predict-lotto-predictor:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PYTHONPATH", "value": "/app" },
        { "name": "MODEL_PATH", "value": "/app/models" },
        { "name": "LOG_LEVEL", "value": "INFO" },
        { "name": "GROQCLOUD_MODEL", "value": "llama-3.3-70b-versatile" },
        { "name": "GROQCLOUD_TEMPERATURE", "value": "0.7" },
        { "name": "GROQCLOUD_MAX_TOKENS", "value": "4096" },
        { "name": "GROQCLOUD_BASE_URL", "value": "https://api.groq.com/openai/v1" },
        { "name": "LANGCHAIN_TRACING_V2", "value": "true" },
        { "name": "LANGCHAIN_ENDPOINT", "value": "https://api.smith.langchain.com" },
        { "name": "LANGCHAIN_PROJECT", "value": "predict-lotto-nz" }
      ],
      "secrets": [
        { "name": "GROQCLOUD_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:897458219603:secret:predict-lotto/production-ckudan:GROQCLOUD_API_KEY::" },
        { "name": "LANGCHAIN_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:897458219603:secret:predict-lotto/production-ckudan:LANGCHAIN_API_KEY::" },
        { "name": "OPENAI_API_KEY", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:897458219603:secret:predict-lotto/production-ckudan:OPENAI_API_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/predict-lotto-predictor",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}

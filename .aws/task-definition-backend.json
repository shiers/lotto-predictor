{
  "family": "predict-lotto-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "predict-lotto-backend",
      "image": "897458219603.dkr.ecr.ap-southeast-2.amazonaws.com/predict-lotto-backend:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "ASPNETCORE_ENVIRONMENT", "value": "Production" },
        { "name": "ASPNETCORE_URLS", "value": "http://+:80" },
        { "name": "REDIS_CONNECTION_STRING", "value": "clustercfg.predict-lotto-redis.hvymco.apse2.cache.amazonaws.com:6379,ssl=true" },
        { "name": "PredictorService__BaseUrl", "value": "http://predict-lotto-predictor:8000" },
        { "name": "AWS__Region", "value": "ap-southeast-2" }
      ],
      "secrets": [
        { "name": "ConnectionStrings__DefaultConnection", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:897458219603:secret:predict-lotto/production-ckudan:DB_CONNECTION_STRING::" },
        { "name": "OpenAI__ApiKey", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:897458219603:secret:predict-lotto/production-ckudan:OPENAI_API_KEY::" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/predict-lotto-backend",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}

{
  "family": "predict-lotto-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "taskRoleArn": "arn:aws:iam::897458219603:role/predict-lotto-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "predict-lotto-frontend",
      "image": "897458219603.dkr.ecr.ap-southeast-2.amazonaws.com/predict-lotto-frontend:latest",
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "VUE_APP_API_BASE_URL", "value": "https://api.lottonz.dryad.ca" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/predict-lotto-frontend",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "essential": true
    }
  ]
}

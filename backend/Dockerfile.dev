# Development Dockerfile with hot reload
FROM mcr.microsoft.com/dotnet/sdk:8.0
WORKDIR /app

# Workaround for transient TLS/SSL issues during dotnet restore in Docker
ENV DOTNET_SYSTEM_NET_HTTP_USESOCKETSHTTPHANDLER=0 \
    NUGET_CERT_REVOCATION_MODE=offline

# Install dotnet-ef tool for migrations
RUN dotnet tool install --global dotnet-ef
ENV PATH="$PATH:/root/.dotnet/tools"

# Copy project file and restore dependencies
COPY *.csproj ./
# Retry restore up to 3 times to handle transient TLS/SSL issues
RUN for i in 1 2 3; do \
    dotnet restore --disable-parallel && break || \
    (echo "Restore attempt $i failed, retrying..." && sleep 5); \
    done

# Copy source code
COPY . ./

# Expose ports
EXPOSE 80
EXPOSE 443

# Run with hot reload - use polling for file watcher in Docker
ENV DOTNET_USE_POLLING_FILE_WATCHER=true
CMD ["dotnet", "watch", "run", "--urls", "http://0.0.0.0:80"]
